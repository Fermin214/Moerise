{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "platform", "client_version", "core_version", "system_major", "rows"],
  "properties": {
    "schema": { "const": 1 },
    "platform": { "enum": ["android", "web"] },
    "client_version": { "$ref": "#/$defs/version" },
    "core_version": { "$ref": "#/$defs/version" },
    "system_major": { "type": "string", "pattern": "^(unknown|[1-9][0-9]{0,2})$" },
    "rows": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/row" } }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^(unknown|(0|[1-9][0-9]{0,2})\\.(0|[1-9][0-9]{0,2})\\.(0|[1-9][0-9]{0,2}))$" },
    "operation": { "enum": ["create", "edit", "enqueue", "save_ack", "sync", "search_keyword", "search_semantic", "search_hybrid", "review", "walk", "stars", "insight", "material_date", "material_tags", "material_manual", "save_answer", "save_multiple", "save_question", "startup", "client_error", "request_error", "crash", "anr"] },
    "result": { "enum": ["success", "failure", "canceled", "conflict", "unknown", "timeout", "over_limit"] },
    "duration": { "enum": ["unknown", "lt300ms", "lt1s", "lt3s", "lt10s", "ge10s"] },
    "source": { "enum": ["user", "prefetch", "background"] },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "result", "duration", "source", "count"],
      "properties": {
        "operation": { "$ref": "#/$defs/operation" },
        "result": { "$ref": "#/$defs/result" },
        "duration": { "$ref": "#/$defs/duration" },
        "source": { "$ref": "#/$defs/source" },
        "count": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    }
  }
}
