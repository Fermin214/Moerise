# Copy to .env. Docker Compose passes these variables to Core.
# Environment values override config.json; blank values keep its settings.
MOERISE_MEMOS_INSTANCE_ID=replace-with-a-unique-instance-id
MOERISE_MEMOS_BASE_URL=https://memos.example.com
MOERISE_MEMOS_PUBLIC_URL=https://memos.example.com
MOERISE_MEMOS_USER=users/replace-with-your-resource-id
MOERISE_MEMOS_TOKEN=
MOERISE_ACCESS_TOKEN=
MOERISE_CURSOR_SECRET=
MOERISE_TIMEZONE=Asia/Hong_Kong
MOERISE_REVIEW_COUNT=3
MOERISE_REVIEW_MIN_AGE_HOURS=72
MOERISE_REVIEW_RECENT_DAYS=7
MOERISE_REVIEW_INCLUDE_ARCHIVED=false
MOERISE_NOTIFICATIONS_ENABLED=false
MOERISE_NOTIFICATIONS_TIMES=09:00
MOERISE_CHANNEL_KIND=feishu-app
MOERISE_FEISHU_APP_ID=
MOERISE_FEISHU_APP_SECRET=
MOERISE_FEISHU_VERIFICATION_TOKEN=
MOERISE_FEISHU_ENCRYPT_KEY=
MOERISE_FEISHU_USER_OPEN_ID=
MOERISE_FEISHU_WEBHOOK_URL=
MOERISE_FEISHU_WEBHOOK_SECRET=
