# Copy to .env. Enable the bundled official Memos, or leave COMPOSE_PROFILES blank for external Memos.
COMPOSE_PROFILES=memos
# Keep the project name stable so upgrades reuse the same named volumes.
COMPOSE_PROJECT_NAME=moerise-local
MOERISE_IMAGE_TAG=0.2.0
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
MEMOS_PORT=5231
MOERISE_PORT=8787
# Infrastructure environment values override config.json; blank values keep built-in defaults.
# Daily settings initialize once, then saved product settings take precedence.
MOERISE_MEMOS_INSTANCE_ID=replace-with-a-unique-instance-id
MOERISE_MEMOS_BASE_URL=http://memos:5230
MOERISE_MEMOS_PUBLIC_URL=http://localhost:5231
MOERISE_MEMOS_USER=users/replace-with-your-resource-id
MOERISE_MEMOS_TOKEN=
MOERISE_ACCESS_TOKEN=
MOERISE_CURSOR_SECRET=
# Use an HTTPS origin for remote access; HTTP is allowed only on loopback.
# Generate independent access/cursor secrets: openssl rand -hex 32 (run separately).
# Generate the state encryption key: openssl rand -base64 32
MOERISE_WEB_ENABLED=true
MOERISE_PUBLIC_ORIGIN=http://localhost:3000
MOERISE_STATE_ENCRYPTION_KEY=
MOERISE_TIMEZONE=Asia/Hong_Kong
MOERISE_REVIEW_COUNT=3
MOERISE_REVIEW_MIN_AGE_HOURS=72
MOERISE_REVIEW_RECENT_DAYS=7
MOERISE_REVIEW_INCLUDE_ARCHIVED=false
MOERISE_NOTIFICATIONS_ENABLED=false
MOERISE_NOTIFICATIONS_TIMES=09:00
MOERISE_CHANNEL_KIND=feishu-app
MOERISE_FEISHU_APP_ID=
MOERISE_FEISHU_APP_SECRET=
MOERISE_FEISHU_VERIFICATION_TOKEN=
MOERISE_FEISHU_ENCRYPT_KEY=
MOERISE_FEISHU_USER_OPEN_ID=
MOERISE_FEISHU_WEBHOOK_URL=
MOERISE_FEISHU_WEBHOOK_SECRET=
